+        // Patched: in .NET 8, Landis.Console.dll.config's <probing
+        // privatePath="8.0;extensions" /> is ignored, and Type.GetType cannot
+        // find types whose assemblies have not yet been loaded by the default
+        // AssemblyLoadContext (dotnet/runtime issue #103222). Register a
+        // Resolving handler so any plug-in assembly referenced by an
+        // AssemblyQualifiedName is located via assembly.GetType() against an
+        // explicitly-loaded Assembly instance.
+        private static readonly string[] PluginProbeSubdirs = new string[]
+        {
+            "",
+            "extensions",
+            Path.Combine("..", "extensions"),
+            "8.0",
+            Path.Combine("..", "8.0"),
+        };
+
+        private static Assembly ResolvePluginAssembly(AssemblyLoadContext context,
+                                                      AssemblyName name)
+        {
+            string simpleName = name.Name;
+            if (string.IsNullOrEmpty(simpleName))
+                return null;
+
+            string baseDir = AppContext.BaseDirectory;
+            foreach (string sub in PluginProbeSubdirs)
+            {
+                string candidate = Path.GetFullPath(
+                    Path.Combine(baseDir, sub, simpleName + ".dll"));
+                if (File.Exists(candidate))
+                {
+                    try
+                    {
+                        return context.LoadFromAssemblyPath(candidate);
+                    }
+                    catch
+                    {
+                        // Try the next probe location.
+                    }
+                }
+            }
+            return null;
+        }
+
         public static int Main(string[] args)
         {
+            // Install plug-in assembly resolver before any extension lookup.
+            AssemblyLoadContext.Default.Resolving += ResolvePluginAssembly;
